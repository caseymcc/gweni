{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
    "name": "gweni",
    "version": "0.1.0",
    "description": "GUI Without Extravagant Nonsense - an OpenGL-aware retained-mode GUI library",
    "homepage": "https://github.com/garrynewman/GWEN",
    "dependencies": [
        "rapidjson",
        "glm",
        "freetype",
        "glew",
        "glfw3",
        "libpng",
        "libjpeg-turbo",
        "doctest"
    ],
    "features": {
        "boost-filesystem": {
            "description": "Boost.Filesystem backend (used on platforms lacking std::filesystem, e.g. Android NDK)",
            "dependencies": [
                "boost-system",
                "boost-filesystem"
            ]
        }
    }
}
