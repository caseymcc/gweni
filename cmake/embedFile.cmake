#
#  Writes a file's bytes as a C++ array, run as a cmake -P script at build time
#  (CMakeLists.txt uses it for the built-in fallback font):
#
#      cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -P embedFile.cmake
#
#  The output defines, in namespace gweni::renderer,
#
#      extern const unsigned char <SYMBOL>[];      // the bytes
#      extern const size_t <SYMBOL>Size;           // how many
#
#  Only CMake itself is used (no xxd or shell), so it runs under every generator.
#

foreach(var INPUT OUTPUT SYMBOL)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "embedFile.cmake: -D${var}=... is required")
    endif()
endforeach()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hexLength)
math(EXPR byteCount "${hexLength} / 2")

if(byteCount EQUAL 0)
    message(FATAL_ERROR "embedFile.cmake: ${INPUT} is empty")
endif()

# 16 bytes (32 hex digits) a line, then each byte as 0xNN, (CMake's regex has no
# {n}, and string(REPEAT) needs 3.15)
set(line "")
foreach(i RANGE 1 32)
    string(APPEND line "[0-9a-f]")
endforeach()
string(REGEX REPLACE "(${line})" "\\1\n" hex "${hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")

get_filename_component(inputName "${INPUT}" NAME)

file(WRITE "${OUTPUT}"
"// Generated by cmake/embedFile.cmake from ${inputName}; do not edit.
#include <cstddef>

namespace gweni
{
namespace renderer
{

extern const unsigned char ${SYMBOL}[];
extern const size_t ${SYMBOL}Size;

const unsigned char ${SYMBOL}[]={
${bytes}
};
const size_t ${SYMBOL}Size=${byteCount};

}//namespace renderer
}//namespace gweni
")
